<article class="section page-width">
  <div class="page-content">
    <p class="eyebrow">{{ article.published_at | date: '%d/%m/%Y' }} — {{ article.author }}</p>
    <h1 class="h1">{{ article.title }}</h1>
    {%- if article.image -%}<div style="margin: 2rem 0">{{ article.image | image_url: width: 1600 | image_tag: alt: article.title, sizes: '(min-width: 820px) 820px, 100vw', widths: '600, 900, 1200, 1600' }}</div>{%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
