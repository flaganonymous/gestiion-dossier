<section class="section page-width">
  <h1 class="h1">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid" style="--cols: 3">
      {%- for article in blog.articles -%}
        <a class="article-card" href="{{ article.url }}" data-reveal>
          {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}{%- endif -%}
          <span class="eyebrow" style="margin:0">{{ article.published_at | date: '%d/%m/%Y' }}</span>
          <h2 class="h3">{{ article.title }}</h2>
          <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
