<section class="not-found page-width">
  <div>
    <p class="eyebrow" style="justify-content:center">{{ shop.name }}</p>
    <h1 class="h0">Bientôt<br><span class="text-outline">sur le ring</span></h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      <div class="newsletter__form">
        <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe">
        <button class="btn" type="submit">Entrer</button>
      </div>
      {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
