<section class="section page-width">
  <h1 class="h1">{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" class="newsletter__form" style="margin: 0 0 2rem; max-width: 720px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button class="btn" type="submit">{% render 'icon', name: 'search' %}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="muted">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="grid" style="--cols: 4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item, index: forloop.index %}
          {%- else -%}
            <a class="article-card" href="{{ item.url }}"><h3 class="h4">{{ item.title }}</h3><p class="muted">{{ item.content | strip_html | truncatewords: 20 }}</p></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
