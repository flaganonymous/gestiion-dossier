{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="{% if section.settings.bg %}background: {{ section.settings.bg }};{% endif %}">
    <div class="marquee" style="--speed: {{ section.settings.speed }}s">
      {%- for n in (1..2) -%}
        <div class="marquee__track" {% if n == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <span class="marquee__item" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'bolt' %}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Barre d'annonce",
  "settings": [
    { "type": "range", "id": "speed", "label": "Vitesse de défilement (s)", "min": 10, "max": 80, "step": 5, "default": 35 },
    { "type": "color", "id": "bg", "label": "Fond (vide = couleur d'accent)" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 69 €" },
      { "type": "url", "id": "link", "label": "Lien" }
    ] }
  ],
  "presets": [{ "name": "Barre d'annonce", "blocks": [
    { "type": "message", "settings": { "text": "Livraison offerte dès 69 €" } },
    { "type": "message", "settings": { "text": "Expédition 24/48h depuis la France" } },
    { "type": "message", "settings": { "text": "Retours gratuits sous 30 jours" } },
    { "type": "message", "settings": { "text": "Équipement Made in EU" } }
  ] }]
}
{% endschema %}
