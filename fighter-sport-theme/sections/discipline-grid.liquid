<section class="section">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="disciplines" style="--cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign img = block.settings.image | default: coll.featured_image
          assign url = block.settings.link | default: coll.url | default: '#'
          assign title = block.settings.title | default: coll.title
        -%}
        <a class="discipline{% if block.settings.large %} discipline--large{% endif %}" href="{{ url }}" data-reveal style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            {{ img | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 900px) 33vw, 50vw', loading: 'lazy', alt: title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if coll != blank and section.settings.show_count -%}<span class="discipline__count">{{ coll.products_count }} réf.</span>{%- endif -%}
          <h3 class="discipline__title">{{ title }}</h3>
          <span class="discipline__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Grille disciplines",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Ta discipline" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Trouve ton combat" },
    { "type": "text", "id": "text", "label": "Texte", "default": "De la boxe anglaise au jiu-jitsu brésilien, l'équipement adapté à chaque art de combat." },
    { "type": "range", "id": "columns", "label": "Colonnes", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_count", "label": "Afficher le nombre de produits", "default": true }
  ],
  "blocks": [
    { "type": "discipline", "name": "Discipline", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Titre (sinon nom de la collection)" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Lien (sinon la collection)" },
      { "type": "checkbox", "id": "large", "label": "Grande tuile", "default": false }
    ] }
  ],
  "presets": [{ "name": "Grille disciplines", "blocks": [
    { "type": "discipline", "settings": { "title": "Boxe", "large": true } },
    { "type": "discipline", "settings": { "title": "MMA" } },
    { "type": "discipline", "settings": { "title": "Muay Thaï" } },
    { "type": "discipline", "settings": { "title": "Karaté" } },
    { "type": "discipline", "settings": { "title": "Judo & JJB" } }
  ] }]
}
{% endschema %}
