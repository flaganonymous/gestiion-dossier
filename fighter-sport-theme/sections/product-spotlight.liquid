{%- liquid
  assign product = section.settings.product
  assign img = section.settings.image | default: product.featured_media
-%}
<section class="section{% if section.settings.light %} section--light{% endif %}">
  <div class="page-width spotlight{% if section.settings.reverse %} spotlight--reverse{% endif %}">
    <div class="spotlight__media" data-reveal data-tilt>
      <div class="spotlight__giant" aria-hidden="true">{{ section.settings.giant_word }}</div>
      {%- if img != blank -%}
        {{ img | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: product.title }}
      {%- else -%}
        {{ 'product-2' | placeholder_svg_tag }}
      {%- endif -%}
      {%- for block in section.blocks -%}
        <div class="hotspot" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
          <button type="button" aria-label="{{ block.settings.title | escape }}">+</button>
          <div class="hotspot__tip"><strong>{{ block.settings.title }}</strong>{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
    <div data-reveal style="--d: 2">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.title | default: product.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="spotlight__features">
          {%- for block in section.blocks -%}
            <li>{% render 'icon', name: 'check' %}<div><strong>{{ block.settings.title }}</strong><br><span class="muted">{{ block.settings.text }}</span></div></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if product != blank -%}
        {% render 'price', product: product, show_from: true %}
        <a class="btn" href="{{ product.url }}">{{ section.settings.cta }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Produit héros",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "image_picker", "id": "image", "label": "Image détourée (sinon image produit)" },
    { "type": "text", "id": "giant_word", "label": "Mot géant en fond", "default": "Power" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Produit star" },
    { "type": "text", "id": "title", "label": "Titre (sinon nom du produit)" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Conçu avec des combattants, testé sur des milliers de rounds.</p>" },
    { "type": "text", "id": "cta", "label": "Bouton", "default": "Je le veux" },
    { "type": "checkbox", "id": "reverse", "label": "Image à droite", "default": false },
    { "type": "checkbox", "id": "light", "label": "Fond clair", "default": false }
  ],
  "blocks": [
    { "type": "feature", "name": "Atout (point interactif)", "limit": 5, "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Mousse multicouche" },
      { "type": "text", "id": "text", "label": "Texte", "default": "Absorption maximale des chocs." },
      { "type": "range", "id": "x", "label": "Position horizontale", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
      { "type": "range", "id": "y", "label": "Position verticale", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 }
    ] }
  ],
  "presets": [{ "name": "Produit héros", "blocks": [
    { "type": "feature", "settings": { "title": "Mousse multicouche", "text": "Absorption maximale des chocs.", "x": 38, "y": 35 } },
    { "type": "feature", "settings": { "title": "Cuir premium", "text": "Résistance et tenue dans le temps.", "x": 62, "y": 55 } },
    { "type": "feature", "settings": { "title": "Fermeture renforcée", "text": "Maintien parfait du poignet.", "x": 45, "y": 75 } }
  ] }]
}
{% endschema %}
