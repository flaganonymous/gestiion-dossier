<section class="section page-width">
  <h1 class="h1">{{ section.settings.title }}</h1>
  <div class="disciplines" style="--cols: 4; margin-top: 2rem;">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        <a class="discipline" href="{{ collection.url }}">
          {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title, sizes: '(min-width: 900px) 25vw, 50vw', widths: '400, 600, 800' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          <span class="discipline__count">{{ collection.products_count }} réf.</span>
          <h2 class="discipline__title" style="font-size: clamp(1.2rem, 2.2vw, 1.9rem)">{{ collection.title }}</h2>
          <span class="discipline__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Liste des collections", "settings": [{ "type": "text", "id": "title", "label": "Titre", "default": "Tout l'équipement" }] }
{% endschema %}
