<section class="page-width not-found">
  <div>
    <p class="h0">K.O.</p>
    <h1 class="h2">{{ 'general.404_title' | t }}</h1>
    <p class="muted">{{ 'general.404_text' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
  </div>
</section>
{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
