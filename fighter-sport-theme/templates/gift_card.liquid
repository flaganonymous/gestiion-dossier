<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Carte cadeau — {{ shop.name }}</title>
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: {{ settings.color_bg }}; color: {{ settings.color_text }}; font-family: system-ui, sans-serif; text-align: center; padding: 16px; }
    .gc { max-width: 520px; padding: 2.5rem; border: 1px solid rgba(255,255,255,.15); border-top: 4px solid {{ settings.color_accent }}; }
    .gc__amount { font-size: 3rem; font-weight: 800; color: {{ settings.color_accent }}; margin: .5rem 0; }
    .gc__code { font-family: monospace; font-size: 1.4rem; letter-spacing: .1em; padding: 1rem; background: rgba(255,255,255,.06); margin: 1rem 0; }
    a, button { display: inline-block; margin-top: 1rem; padding: 1rem 2rem; background: {{ settings.color_accent }}; color: #fff; text-decoration: none; border: 0; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; cursor: pointer; }
    #QrCode img, #QrCode canvas { margin: 1rem auto; background: #fff; padding: 8px; }
  </style>
</head>
<body>
  <div class="gc">
    <p>{{ shop.name }}</p>
    <div class="gc__amount">{{ gift_card.balance | money }}</div>
    {%- if gift_card.expired or gift_card.enabled == false -%}<p>Cette carte n'est plus valide.</p>{%- endif -%}
    <div class="gc__code">{{ gift_card.code | format_code }}</div>
    <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
    <a href="{{ shop.url }}">Utiliser en boutique en ligne</a>
    <br><button onclick="window.print()">Imprimer</button>
  </div>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('QrCode');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
    });
  </script>
</body>
</html>
