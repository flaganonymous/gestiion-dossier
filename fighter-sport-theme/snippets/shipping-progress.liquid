{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  if threshold > 0
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  endif
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  <div class="ship-progress{% if remaining <= 0 %} ship-progress--done{% endif %}">
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      {{ 'cart.shipping_remaining_html' | t: amount: remaining_money }}
    {%- else -%}
      <strong>{{ 'cart.shipping_unlocked' | t }}</strong>
    {%- endif -%}
    <div class="ship-progress__bar"><span style="--p: {{ percent }}%"></span></div>
  </div>
{%- endif -%}
