{%- comment -%} Usage : {% render 'icon', name: 'cart' %} {%- endcomment -%}
{%- case name -%}
  {%- when 'cart' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 7h14l-1.2 12.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 7Z"/><path d="M9 7V6a3 3 0 0 1 6 0v1"/></svg>
  {%- when 'search' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  {%- when 'account' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
  {%- when 'menu' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h12M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
  {%- when 'plus' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'arrow' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
  {%- when 'arrow-up-right' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
  {%- when 'star' -%}
    <svg class="icon star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.6 7.1.6-5.4 4.7 1.6 7.1L12 17.3 5.8 21l1.6-7.1L2 9.2l7.1-.6L12 2Z"/></svg>
  {%- when 'bolt' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
  {%- when 'glove' -%}
    <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M14 30V16a10 10 0 0 1 10-10h4a10 10 0 0 1 10 10v8a6 6 0 0 1-6 6H14Z"/><path d="M14 22H11a4 4 0 0 0 0 8h3"/><path d="M14 30v6a4 4 0 0 0 4 4h12a4 4 0 0 0 4-4v-6"/><path d="M22 18h10"/></svg>
  {%- when 'truck' -%}
    <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12h24v20H4zM28 20h9l7 7v5h-16z"/><circle cx="12" cy="35" r="4"/><circle cx="36" cy="35" r="4"/></svg>
  {%- when 'return' -%}
    <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M10 18h22a10 10 0 0 1 0 20H16"/><path d="m16 10-8 8 8 8"/></svg>
  {%- when 'shield' -%}
    <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M24 4 8 10v12c0 10 7 18 16 22 9-4 16-12 16-22V10L24 4Z"/><path d="m17 24 5 5 9-10"/></svg>
  {%- when 'eu' -%}
    <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="24" cy="24" r="18"/>{%- for a in (0..11) -%}{%- assign deg = a | times: 30 -%}<circle cx="24" cy="12" r="1.6" fill="currentColor" stroke="none" transform="rotate({{ deg }} 24 24)"/>{%- endfor -%}</svg>
  {%- when 'chat' -%}
    <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 10h36v22H20l-10 8v-8H6z"/><path d="M14 20h20M14 26h12"/></svg>
  {%- when 'check' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m4 12 5 5L20 6"/></svg>
  {%- when 'ruler' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 15 15 3l6 6L9 21z"/><path d="m7 11 2 2m1-5 2 2m1-5 2 2"/></svg>
  {%- when 'filter' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8Z"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8ZM10 15V9l5.2 3L10 15Z"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3a5 5 0 0 0 4 4.2v3.2a8 8 0 0 1-4-1.2v6.3A6.5 6.5 0 1 1 10 9v3.3a3.2 3.2 0 1 0 3.2 3.2V3h3.3Z"/></svg>
{%- endcase -%}
